{
  "schemaVersion": 1,
  "id": "carpet-fixes",
  "version": "${version}",
  "name": "Carpet Fixes (Unofficial 1.21.1 Port)",
  "description": "Unofficial Minecraft 1.21.1 Fabric compatibility port of Carpet Fixes, based on tomalbrc's 1.21 branch.",
  "authors": [
    "FX - PR0CESS (original author)",
    "tomalbrc (1.21 source base)",
    "JustHari01 (1.21.1 compatibility port)"
  ],
  "contact": {
    "homepage": "https://github.com/fxmorin/carpet-fixes",
    "sources": "https://github.com/tomalbrc/carpet-fixes",
    "issues": "https://github.com/tomalbrc/carpet-fixes/issues"
  },

  "license": "MIT",
  "icon": "assets/carpet-fixes/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "carpetfixes.CarpetFixesServer"
    ],
    "preLaunch": [
      "com.llamalad7.mixinextras.MixinExtrasBootstrap::init"
    ]
  },
  "mixins": [
    "carpet-fixes.mixins.json"
  ],
  "accessWidener" : "carpet-fixes.accesswidener",
  "depends": {
    "minecraft": "~1.21.1",
    "fabricloader": ">=0.16.9",
    "carpet": ">=1.4.147",
    "java": ">=21",
    "conditional-mixin": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/mezndgtD83"
      },
      "parent": "carpet"
    }
  }
}
